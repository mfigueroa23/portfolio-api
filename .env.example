# Copy to .env (gitignored). Only the database URL lives in the environment;
# application secrets are stored in the `property` table.
DATABASE_URL="postgresql://<username>:<password>@<host>:5432/<database_name>?schema=public"

# This is used by Prisma Migrate to create a temporary database for diffing the schema.
# no need to add this on your production server, as it is only used during development and CI.
SHADOW_DATABASE_URL="postgresql://<username>:<password>@<host>:5432/<database_name>_shadow?schema=public"
